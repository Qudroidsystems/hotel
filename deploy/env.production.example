# Live server settings. Copy to /var/www/hotel/.env, fill in the <...> values, then: php artisan key:generate
# Most hotel settings (name, taxes, Paystack, email, SMS) are set later in Hotel Settings, not here.

APP_NAME="B Luxury"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://<domain>

HOTEL_NAME="B Luxury"

# First Super Admin (php artisan db:seed). Asked to change the password at first sign-in.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=<your email>
ADMIN_PASSWORD=<a temporary password>

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel
DB_USERNAME=hotel
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email is set in Hotel Settings → Email; this is only the fallback.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<domain>"
MAIL_FROM_NAME="${HOTEL_NAME}"

# Backups (deploy/backup.sh): where the nightly copy goes off the server, as an rclone remote:path
# e.g. BACKUP_REMOTE=b2:bluxury-backups   (set up once with: sudo -u www-data rclone config)
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
